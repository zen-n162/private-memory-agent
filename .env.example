# Application
PMA_ENV=local
PMA_LOG_LEVEL=INFO

# Paths
PMA_MODEL_ROOT=/home/zennakamura/MyApplication/models
PMA_APP_DATA_DIR=data/local
PMA_CONFIG_DIR=configs

# Privacy
PMA_PRIVACY_MODE=strict
PMA_ALLOW_NETWORK=false
PMA_LOG_PRIVATE_DATA=false

# Runtime
PMA_DEFAULT_CONTEXT_TOKENS=8192
PMA_MAX_CONTEXT_TOKENS=16384
PMA_GPU_MEMORY_LIMIT_GB=21

# Optional per-model overrides
# PMA_MODEL_LEADER_ENABLED=false
